# All values are server-side only. Never prefix with VITE_ or embed in browser code.

# Model provider: set ONE. Anthropic is used when ANTHROPIC_API_KEY is set; otherwise Gemini.
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Google sign-in: OAuth 2.0 "Web application" client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
# Random string of 32+ characters used to sign session cookies, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Comma-separated Google account emails that can open the admin page (and are not limited)
ADMIN_EMAILS=

# Supabase project storing users and token usage. Use the service_role / secret key, never the anon key.
SUPABASE_URL=https://qrkwjtkebwsgfxtcfzgi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

PORT=8787
