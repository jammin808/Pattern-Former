# Set ONE of these in the server environment. Never prefix with VITE_ or embed in browser code.
# Anthropic is used when ANTHROPIC_API_KEY is set; otherwise Gemini.
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Alternative provider. A model compatible with responseMimeType: application/json
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

PORT=8787
