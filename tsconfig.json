{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "types": ["node"], "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "noEmit": true, "isolatedModules": true
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
